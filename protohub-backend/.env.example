# Neon PostgreSQL connection string
# Use the pooled connection for the app, and set a direct connection if you need it for migrations.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/protohub?sslmode=require"

# Auth
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"

PORT=4000

# ---------------------------------------------------------------------------
# AI Feature Flag
# Set to "true" only after API keys are configured and validated.
# Defaults to "false" — all AI endpoints return 503 when disabled.
# ---------------------------------------------------------------------------
AI_FEATURES_ENABLED=false
# ---------------------------------------------------------------------------
# AI Provider Configuration (required when AI_FEATURES_ENABLED=true)
# ---------------------------------------------------------------------------
# OpenAI API key — obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-replace-with-your-openai-key"

# Model to use for chat completions (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"
